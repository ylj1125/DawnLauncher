// 项目卡片组件
import { ThemeSettings } from "../theme.slint";
import { DragHelper } from "./drag_helper.slint";

// 项目数据模型 (Slint 全局使用)
export struct ItemInfo {
    id: int,
    name: string,
    icon: image,
    invalid: bool,
    selected: bool,
}

// 项目卡片 (tile / list 两种外观，由 layout 属性切换)
export component ItemCard inherits Rectangle {
    in property <int> item-id;
    in property <string> name;
    in property <image> icon;
    in property <bool> invalid;
    in property <bool> selected;
    in property <string> theme-mode: "light";
    in property <bool> batch-mode: false;
    in property <length> icon-size: ThemeSettings.item-icon-size;
    in property <bool> hide-name: false;
    in property <string> layout: "tile";  // tile 卡片布局 / list 行布局
    in property <string> show-only: "default";
    in property <length> list-width: 400px;  // list 模式下的行宽

    callback clicked;
    callback double-clicked;
    callback right-clicked;

    // ===== 尺寸 =====
    width: root.layout == "list" ? root.list-width : ThemeSettings.item-card-width;
    height: root.layout == "list" ? 36px : (root.hide-name ? ThemeSettings.item-card-width : ThemeSettings.item-card-height);
    border-radius: ThemeSettings.border-radius;
    background: selected
        ? ThemeSettings.selected-c(root.theme-mode)
        : (touch-area.has-hover ? ThemeSettings.hover-c(root.theme-mode) : transparent);
    border-width: (root.batch-mode && root.selected) ? 2px : 0px;
    border-color: ThemeSettings.accent-color;

    // ===== 视觉层：图标 + 名称 =====
    // tile 模式 - 居中堆叠
    if root.layout != "list" : VerticalLayout {
        alignment: center;
        spacing: ThemeSettings.spacing-small;
        padding: ThemeSettings.spacing-small;
        width: 100%;
        height: 100%;

        Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            opacity: root.invalid ? 0.3 : 1.0;
            horizontal-alignment: center;
            image-fit: contain;
        }

        if !root.hide-name : Text {
            text: root.name;
            color: root.invalid ? ThemeSettings.invalid-c(root.theme-mode) : ThemeSettings.text-c(root.theme-mode);
            font-size: ThemeSettings.font-size-small;
            horizontal-alignment: center;
            overflow: elide;
            width: 72px;
        }
    }

    // list 模式 - 水平行
    if root.layout == "list" : HorizontalLayout {
        spacing: 10px;
        padding-left: 10px;
        padding-right: 10px;
        width: 100%;
        height: 100%;

        Image {
            source: root.icon;
            width: max(root.icon-size, 24px);
            height: max(root.icon-size, 24px);
            opacity: root.invalid ? 0.3 : 1.0;
            vertical-alignment: center;
            image-fit: contain;
        }

        Text {
            text: root.name;
            color: root.invalid ? ThemeSettings.invalid-c(root.theme-mode) : ThemeSettings.text-c(root.theme-mode);
            font-size: ThemeSettings.font-size-normal;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    // ===== 事件层（后声明 = 上层）=====

    // 主点击区域 - 整张卡片的点击/双击/右键
    touch-area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
    }

    // DropArea 铺满整张卡片（平时透明，拖放时拦截）
    DropArea {
        width: 100%;
        height: 100%;
        can-drop(event) => {
            (DragHelper.kind-of(event.data) == "item"
                && DragHelper.id-of(event.data) != root.item-id)
                ? DragAction.move
                : DragAction.none
        }
        dropped(event) => {
            if (DragHelper.kind-of(event.data) == "item") {
                DragHelper.drop-on("item", DragHelper.id-of(event.data), root.item-id);
            }
            return DragAction.move;
        }
    }

    // ===== 拖拽排序手柄（最上层，覆盖 TouchArea）=====
    // tile 模式 - 左上角小方块
    if root.layout != "list" : Rectangle {
        x: 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        background: transparent;

        // 手柄可见：用两条横线表示 grip
        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 2px;
            alignment: center;

            VerticalLayout {
                spacing: 2px;
                Rectangle { width: 10px; height: 2px; background: ThemeSettings.text-sec(root.theme-mode); opacity: 0.35; }
                Rectangle { width: 10px; height: 2px; background: ThemeSettings.text-sec(root.theme-mode); opacity: 0.35; }
            }
        }

        DragArea {
            width: 100%;
            height: 100%;
            allow-move: true;
            data: DragHelper.make-item(root.item-id);
            drag-image: root.icon;
            drag-image-offset-x: 12;
            drag-image-offset-y: 12;
        }
    }

    // list 模式 - 左侧拖拽区
    if root.layout == "list" : Rectangle {
        x: 0px;
        width: 12px;
        height: 100%;
        background: transparent;

        DragArea {
            width: 100%;
            height: 100%;
            allow-move: true;
            data: DragHelper.make-item(root.item-id);
            drag-image: root.icon;
            drag-image-offset-x: 12;
            drag-image-offset-y: 12;
        }
    }

    animate background { duration: 120ms; }
}
