// 分类标签组件
import { ThemeSettings } from "../theme.slint";
import { DragHelper } from "./drag_helper.slint";

export component ClassificationTab inherits Rectangle {
    in property <int> tab-id;
    in property <string> name;
    in property <bool> selected;
    in property <string> theme-mode: "light";
    in property <int> depth: 0;
    in property <bool> has-children: false;
    in property <bool> expanded: true;
    in property <image> icon;

    callback clicked;
    callback right-clicked;
    callback expand-toggled;

    height: 36px;
    horizontal-stretch: 1;
    border-radius: ThemeSettings.border-radius;
    background: selected ? ThemeSettings.selected-c(root.theme-mode) : (touch-area.has-hover ? ThemeSettings.hover-c(root.theme-mode) : transparent);

    HorizontalLayout {
        alignment: start;
        spacing: ThemeSettings.spacing-normal;
        // 子分类缩进
        padding-left: ThemeSettings.spacing-normal + root.depth * 16px;
        padding-right: ThemeSettings.spacing-normal;

        // 子分类折叠箭头 (有子分类时显示，可点击切换展开/折叠)
        Rectangle {
            width: 12px;
            height: 100%;

            Text {
                text: root.has-children ? (root.expanded ? "▾" : "▸") : "";
                color: ThemeSettings.text-sec(root.theme-mode);
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // 仅在有子分类时响应点击
            arrow-touch := TouchArea {
                enabled: root.has-children;
                clicked => { root.expand-toggled(); }
            }
        }

        // 分类图标 (仅在设置了图标时显示)
        Rectangle {
            width: 18px;
            height: 18px;
            Image {
                source: root.icon;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            text: root.name;
            color: root.selected ? ThemeSettings.accent-color : ThemeSettings.text-c(root.theme-mode);
            font-size: ThemeSettings.font-size-normal;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
    }

    // ===== 拖拽排序 =====
    // 右侧拖拽手柄（避免与单击选择冲突）
    Rectangle {
        x: root.width - 18px;
        y: (root.height - 16px) / 2;
        width: 14px;
        height: 16px;
        background: transparent;

        Text {
            text: "⋮";
            color: ThemeSettings.text-sec(root.theme-mode);
            opacity: 0.5;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        DragArea {
            width: 100%;
            height: 100%;
            allow-move: true;
            data: DragHelper.make-class(root.tab-id);
        }
    }

    // 放置区域（覆盖整个分类项）
    DropArea {
        width: 100%;
        height: 100%;

        can-drop(event) => {
            (DragHelper.kind-of(event.data) == "class"
                && DragHelper.id-of(event.data) != root.tab-id)
                ? DragAction.move
                : DragAction.none
        }

        dropped(event) => {
            if (DragHelper.kind-of(event.data) == "class") {
                DragHelper.drop-on("class", DragHelper.id-of(event.data), root.tab-id);
            }
            return DragAction.move;
        }
    }

    animate background { duration: 120ms; }
}
