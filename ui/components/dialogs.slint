// 通用对话框组件（替代 PowerShell 输入框）
// - InputDialog: 单行文本输入
// - MultilineInputDialog: 多行文本输入
// - ActionDialog: 动作选择（按钮列表）

import { ThemeSettings } from "../theme.slint";

// 对话框按钮
component dialog-btn inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <string> theme-mode: "light";

    callback clicked;

    width: 80px;
    height: 32px;
    border-radius: 6px;
    background: root.primary
        ? ThemeSettings.accent-color
        : (btn-hover.has-hover ? ThemeSettings.hover-c(root.theme-mode) : ThemeSettings.card-bg(root.theme-mode));
    border-width: 1px;
    border-color: root.primary
        ? ThemeSettings.accent-color
        : ThemeSettings.border-c(root.theme-mode);

    Text {
        text: root.label;
        font-size: ThemeSettings.font-size-normal;
        color: root.primary ? #ffffff : ThemeSettings.text-c(root.theme-mode);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    btn-hover := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// 单行输入对话框
export component InputDialog inherits Window {
    title: root.dlg-title;
    background: ThemeSettings.bg-color(root.theme-mode);
    default-font-family: ThemeSettings.font-family;
    preferred-width: 440px;
    preferred-height: 200px;
    min-width: 360px;
    min-height: 180px;

    in property <string> theme-mode: "light";
    in property <string> dlg-title: "输入";
    in property <string> prompt: "";
    in property <string> default-text: "";
    in-out property <string> input-text: "";

    callback accepted(string);
    callback cancelled();

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Text {
            text: root.prompt;
            font-size: ThemeSettings.font-size-normal;
            color: ThemeSettings.text-c(root.theme-mode);
            wrap: word-wrap;
        }

        Rectangle {
            height: 34px;
            border-radius: 6px;
            background: ThemeSettings.card-bg(root.theme-mode);
            border-width: 1px;
            border-color: ThemeSettings.border-c(root.theme-mode);

            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                single-line: true;
                text: root.input-text;
                font-size: ThemeSettings.font-size-normal;
                color: ThemeSettings.text-c(root.theme-mode);
                vertical-alignment: center;
                edited => { root.input-text = self.text; }
                accepted => { root.accepted(root.input-text); }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;

            dialog-btn {
                label: "确定";
                primary: true;
                theme-mode: root.theme-mode;
                clicked => { root.accepted(root.input-text); }
            }
            dialog-btn {
                label: "取消";
                theme-mode: root.theme-mode;
                clicked => { root.cancelled(); }
            }
        }
    }

    init => { input.focus(); }
}

// 多行输入对话框
export component MultilineInputDialog inherits Window {
    title: root.dlg-title;
    background: ThemeSettings.bg-color(root.theme-mode);
    default-font-family: ThemeSettings.font-family;
    preferred-width: 580px;
    preferred-height: 500px;
    min-width: 400px;
    min-height: 360px;

    in property <string> theme-mode: "light";
    in property <string> dlg-title: "输入";
    in property <string> prompt: "";
    in-out property <string> input-text: "";

    callback accepted(string);
    callback cancelled();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: root.prompt;
            font-size: ThemeSettings.font-size-small;
            color: ThemeSettings.text-sec(root.theme-mode);
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            background: ThemeSettings.card-bg(root.theme-mode);
            border-width: 1px;
            border-color: ThemeSettings.border-c(root.theme-mode);

            input := TextInput {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                height: parent.height - 12px;
                single-line: false;
                wrap: no-wrap;
                text: root.input-text;
                font-size: 13px;
                font-family: "Consolas, monospace";
                color: ThemeSettings.text-c(root.theme-mode);
                edited => { root.input-text = self.text; }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;

            dialog-btn {
                label: "确定";
                primary: true;
                theme-mode: root.theme-mode;
                clicked => { root.accepted(root.input-text); }
            }
            dialog-btn {
                label: "取消";
                theme-mode: root.theme-mode;
                clicked => { root.cancelled(); }
            }
        }
    }

    init => { input.focus(); }
}

// 动作选择对话框（按钮列表）
export component ActionDialog inherits Window {
    title: root.dlg-title;
    background: ThemeSettings.bg-color(root.theme-mode);
    default-font-family: ThemeSettings.font-family;
    preferred-width: 360px;
    preferred-height: 280px;
    min-width: 280px;

    in property <string> theme-mode: "light";
    in property <string> dlg-title: "选择操作";
    in property <string> prompt: "";
    in property <[string]> actions: [];

    callback selected(string);
    callback cancelled();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: root.prompt;
            font-size: ThemeSettings.font-size-small;
            color: ThemeSettings.text-sec(root.theme-mode);
            wrap: word-wrap;
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            for action in root.actions : Rectangle {
                height: 40px;
                horizontal-stretch: 1;
                border-radius: 6px;
                background: action-hover.has-hover ? ThemeSettings.hover-c(root.theme-mode) : ThemeSettings.card-bg(root.theme-mode);
                border-width: 1px;
                border-color: ThemeSettings.border-c(root.theme-mode);

                Text {
                    text: action;
                    font-size: ThemeSettings.font-size-normal;
                    color: ThemeSettings.text-c(root.theme-mode);
                    vertical-alignment: center;
                    x: 14px;
                }

                action-hover := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.selected(action); }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            dialog-btn {
                label: "取消";
                theme-mode: root.theme-mode;
                clicked => { root.cancelled(); }
            }
        }
    }
}
