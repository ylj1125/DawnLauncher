// 设置项通用组件
// 提供开关、设置行等可复用组件

import { ThemeSettings } from "../theme.slint";

// 开关组件
export component SettingSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <string> theme-mode: "light";

    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: self.height / 2;
    background: root.checked ? ThemeSettings.accent-color : ThemeSettings.border-c(root.theme-mode);

    Rectangle {
        width: 20px;
        height: 20px;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 2px : 2px;
        background: #ffffff;
        border-radius: self.height / 2;
        animate x { duration: 120ms; }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(!root.checked); }
    }
}

// 分组标题
export component SettingGroupTitle inherits Rectangle {
    in property <string> text: "";
    in property <string> theme-mode: "light";

    height: 28px;
    horizontal-stretch: 1;

    Text {
        text: root.text;
        color: ThemeSettings.text-c(root.theme-mode);
        font-size: ThemeSettings.font-size-normal;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
}

// 可拖动滑块组件
export component SettingSlider inherits Rectangle {
    in property <float> value: 0;
    in property <float> min: 0;
    in property <float> max: 100;
    in property <float> step: 1;
    in property <string> theme-mode: "light";

    callback changed(float);

    height: 24px;

    // 进度百分比
    in property <float> ratio: max > min ? (value - min) / (max - min) : 0;

    // 轨道
    Rectangle {
        height: 6px;
        y: (parent.height - self.height) / 2;
        width: 100%;
        background: ThemeSettings.border-c(root.theme-mode);
        border-radius: 3px;

        // 填充进度
        Rectangle {
            height: 100%;
            width: parent.width * root.ratio;
            background: ThemeSettings.accent-color;
            border-radius: 3px;
        }
    }

    // 滑块 thumb
    Rectangle {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) * root.ratio;
        y: (parent.height - self.height) / 2;
        background: #ffffff;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: ThemeSettings.accent-color;
    }

    // 交互层：点击跳转 + 拖动
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.move) {
                let r = self.mouse-x / self.width;
                let clamped-r = clamp(r, 0.0, 1.0);
                let range = max - min;
                let raw = min + range * clamped-r;
                let stepped = min + round((raw - min) / step) * step;
                let clamped = clamp(stepped, min, max);
                root.changed(clamped);
            }
        }
    }
}
