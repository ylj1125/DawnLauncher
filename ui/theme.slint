// 主题全局变量
// 颜色函数定义在 global 内部，根据传入的 mode 返回对应颜色
// 运行时主题切换通过 MainWindow.theme-mode 驱动各组件颜色实现

export global ThemeSettings {
    // 尺寸 (固定值)
    out property <length> font-size-small: 11px;
    out property <length> font-size-normal: 13px;
    out property <length> font-size-large: 15px;
    out property <length> sidebar-width: 180px;
    out property <length> item-card-width: 80px;
    out property <length> item-card-height: 90px;
    out property <length> item-icon-size: 48px;
    out property <length> border-radius: 6px;
    out property <length> spacing-small: 4px;
    out property <length> spacing-normal: 8px;
    out property <length> spacing-large: 12px;

    // 字体
    out property <string> font-family: "Microsoft YaHei UI";

    // 强调色 (light/dark 通用)
    out property <color> accent-color: #3b82f6;

    // ===== 主题颜色函数 =====
    // 根据传入的 mode ("light"/"dark") 返回对应颜色
    // pure function 可在属性绑定中调用

    // 主背景
    pure public function bg-color(mode: string) -> color {
        return mode == "dark" ? #1e1e1e : #f5f6f7;
    }

    // 侧栏/标题栏背景
    pure public function sidebar-bg(mode: string) -> color {
        return mode == "dark" ? #252526 : #ffffff;
    }

    // 主文本色
    pure public function text-c(mode: string) -> color {
        return mode == "dark" ? #d4d4d4 : #2c2c2c;
    }

    // 次要文本色
    pure public function text-sec(mode: string) -> color {
        return mode == "dark" ? #888888 : #888888;
    }

    // 悬停色
    pure public function hover-c(mode: string) -> color {
        return mode == "dark" ? #2a2a2a : #f0f0f0;
    }

    // 选中色
    pure public function selected-c(mode: string) -> color {
        return mode == "dark" ? #094771 : #e8f0fe;
    }

    // 边框色
    pure public function border-c(mode: string) -> color {
        return mode == "dark" ? #3c3c3c : #e5e7eb;
    }

    // 卡片背景
    pure public function card-bg(mode: string) -> color {
        return mode == "dark" ? #2d2d2d : #ffffff;
    }

    // 卡片悬停色
    pure public function card-hover-c(mode: string) -> color {
        return mode == "dark" ? #383838 : #f5f9ff;
    }

    // 无效色
    pure public function invalid-c(mode: string) -> color {
        return mode == "dark" ? #555555 : #cccccc;
    }
}
