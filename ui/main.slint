// 主界面
import { ScrollView, ListView, StandardListView } from "std-widgets.slint";
import { ThemeSettings } from "theme.slint";
import { ItemCard, ItemInfo } from "components/item_card.slint";
import { ClassificationTab } from "components/classification_tab.slint";

// 分类数据模型
export struct ClassificationInfo {
    id: int,
    name: string,
    selected: bool,
}

export component MainWindow inherits Window {
    title: "Dawn Launcher";
    background: ThemeSettings.background-color;
    default-font-family: ThemeSettings.font-family;
    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 600px;
    min-height: 400px;

    // 数据属性
    in property <[ClassificationInfo]> classifications;
    in property <[ItemInfo]> items;
    in property <string> status-text: "Dawn Launcher";
    // 拖拽提示显隐
    in property <bool> drag-hover: false;

    // 回调
    callback classification-clicked(int);
    callback item-clicked(int);
    callback item-double-clicked(int);
    callback item-right-clicked(int);
    callback classification-right-clicked(int);
    callback window-close();
    // 新增回调
    callback add-item-clicked();          // 工具栏"添加项目"按钮
    callback add-classification-clicked(); // 左侧栏底部"+"
    callback delete-item-requested(int);  // 删除项目
    callback delete-classification-requested(int); // 删除分类
    callback rename-classification-requested(int); // 重命名分类
    callback item-dropped(string);        // 拖拽文件到窗口
    callback settings-clicked();          // 设置按钮

    // 用 VerticalLayout 包裹所有内容，确保布局跟随窗口大小
    VerticalLayout {
        spacing: 0px;

        // 标题栏 (拖拽区域)
        title-bar := Rectangle {
            height: 32px;
            background: ThemeSettings.sidebar-background-color;

            HorizontalLayout {
                // 标题
                Text {
                    text: "Dawn Launcher";
                    color: ThemeSettings.text-color;
                    font-size: ThemeSettings.font-size-normal;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    padding-left: ThemeSettings.spacing-normal;
                }

                // 设置按钮
                Rectangle {
                    width: 40px;
                    height: parent.height;
                    background: settings-touch.has-hover ? ThemeSettings.hover-color : transparent;

                    Text {
                        text: "⚙";
                        color: ThemeSettings.text-color;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    settings-touch := TouchArea {
                        clicked => { root.settings-clicked(); }
                    }
                }

                // 关闭按钮
                Rectangle {
                    width: 40px;
                    height: parent.height;
                    background: close-touch.has-hover ? #e81123 : transparent;

                    Text {
                        text: "×";
                        color: ThemeSettings.text-color;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        clicked => { root.window-close(); }
                    }
                }
            }
        }

        // 主内容区: horizontal-stretch: 1 + vertical-stretch: 1 确保填充剩余空间
        HorizontalLayout {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            spacing: 0px;

            // 左侧分类栏
            Rectangle {
                width: ThemeSettings.sidebar-width;
                background: ThemeSettings.sidebar-background-color;

                VerticalLayout {
                    padding: ThemeSettings.spacing-small;
                    spacing: ThemeSettings.spacing-small;

                    // 分类列表
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 2px;
                            for c in root.classifications : ClassificationTab {
                                tab-id: c.id;
                                name: c.name;
                                selected: c.selected;
                                clicked => { root.classification-clicked(c.id); }
                                right-clicked => { root.classification-right-clicked(c.id); }
                            }
                        }
                    }

                    // 底部添加分类按钮
                    Rectangle {
                        height: 32px;
                        horizontal-stretch: 1;
                        border-radius: ThemeSettings.border-radius;
                        background: add-class-touch.has-hover ? ThemeSettings.hover-color : transparent;

                        HorizontalLayout {
                            alignment: center;
                            spacing: ThemeSettings.spacing-small;

                            Text {
                                text: "+ 新建分类";
                                color: ThemeSettings.text-secondary-color;
                                font-size: ThemeSettings.font-size-normal;
                                vertical-alignment: center;
                            }
                        }

                        add-class-touch := TouchArea {
                            clicked => { root.add-classification-clicked(); }
                        }
                    }
                }
            }

            // 分隔线
            Rectangle {
                width: 1px;
                background: ThemeSettings.border-color;
            }

            // 右侧内容区
            VerticalLayout {
                horizontal-stretch: 1;
                padding: ThemeSettings.spacing-large;
                spacing: ThemeSettings.spacing-normal;

                // 工具栏
                HorizontalLayout {
                    height: 32px;
                    spacing: ThemeSettings.spacing-normal;
                    alignment: space-between;

                    Text {
                        text: root.status-text;
                        color: ThemeSettings.text-secondary-color;
                        font-size: ThemeSettings.font-size-small;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // 添加项目按钮
                    Rectangle {
                        width: 96px;
                        height: 28px;
                        border-radius: ThemeSettings.border-radius;
                        background: add-item-touch.has-hover ? #3b82f6 : #e8f0fe;

                        Text {
                            text: "+ 添加项目";
                            color: add-item-touch.has-hover ? #ffffff : ThemeSettings.accent-color;
                            font-size: ThemeSettings.font-size-small;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        add-item-touch := TouchArea {
                            clicked => { root.add-item-clicked(); }
                        }
                    }
                }

                // 项目网格区
                Rectangle {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    background: root.drag-hover ? #f0f7ff : transparent;
                    border-radius: ThemeSettings.border-radius;
                    border-width: root.drag-hover ? 2px : 0px;
                    border-color: ThemeSettings.accent-color;

                    // 空状态提示
                    if root.items.length == 0 : Text {
                        text: root.drag-hover ?
                            "松开以添加项目" :
                            "暂无项目\n\n点击右上角「+ 添加项目」\n或将文件/快捷方式拖入此区域";
                        color: ThemeSettings.text-secondary-color;
                        font-size: ThemeSettings.font-size-normal;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            spacing: ThemeSettings.spacing-normal;

                            for item in root.items : ItemCard {
                                item-id: item.id;
                                name: item.name;
                                icon: item.icon;
                                invalid: item.invalid;
                                selected: item.selected;
                                clicked => { root.item-clicked(item.id); }
                                double-clicked => { root.item-double-clicked(item.id); }
                                right-clicked => { root.item-right-clicked(item.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
